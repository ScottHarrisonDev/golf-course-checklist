---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Golf courses I want to play, on a map and in a list.' } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F2C3F" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500..800&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  /* App frame: content fills exactly one screen; the page itself never scrolls.
     Views (map, list) scroll inside their own panel. */
  body {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }
</style>
