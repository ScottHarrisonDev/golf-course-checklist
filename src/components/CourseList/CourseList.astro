---
/**
 * Course list (F4): A–Z course cards with All / To play / Played filters and a Played
 * checkbox per course. Fills the List tab panel. Receives the courses (already A–Z) as
 * `courses`.
 *
 * Server-rendered as if nothing is played; the island (`list.ts`) then reads the store,
 * handles the filters and checkboxes, and follows changes made elsewhere (e.g. the map).
 */
import PlayedIcon from '../icons/PlayedIcon.astro';
import type { Course } from '../../lib/types';
import { EMPTY_MESSAGES, FILTERS, FILTER_LABELS, filterCounts } from './filter';

interface Props {
  courses: Course[];
}

const { courses } = Astro.props;
const counts = filterCounts(courses.map(() => false));
---

<div class="course-list" data-course-list>
  <h2 class="visually-hidden">Courses</h2>

  <div class="course-list__filters" role="group" aria-label="Filter courses">
    {
      FILTERS.map((filter) => (
        <button
          type="button"
          class="filter"
          data-filter={filter}
          aria-pressed={filter === 'all' ? 'true' : 'false'}
        >
          {FILTER_LABELS[filter]}
          <span class="filter__count" data-count>
            {counts[filter]}
          </span>
        </button>
      ))
    }
  </div>

  <ul class="course-list__cards" data-list hidden={courses.length === 0}>
    {
      courses.map((course) => (
        <li
          class="card"
          data-course-id={course.id}
          data-course-name={course.name}
          data-played="false"
        >
          <div class="card__head">
            <span class="card__icon card__icon--unplayed">
              <PlayedIcon played={false} size={32} />
            </span>
            <span class="card__icon card__icon--played">
              <PlayedIcon played={true} size={32} />
            </span>
            <div>
              <h3 class="card__name">{course.name}</h3>
              <p class="card__location">{course.location}</p>
            </div>
          </div>
          <div class="card__foot">
            <span class="card__chip">{course.holes} holes</span>
            {course.url && (
              <a class="card__link" href={course.url} target="_blank" rel="noopener noreferrer">
                Website
                <span class="visually-hidden"> for {course.name} (opens in a new tab)</span>
                <svg
                  class="card__link-icon"
                  viewBox="0 0 16 16"
                  width="14"
                  height="14"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    d="M6 3h7v7M13 3 4 12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            )}
            <label class="card__played">
              <input type="checkbox" />
              <span>
                Played<span class="visually-hidden"> {course.name}</span>
              </span>
            </label>
          </div>
        </li>
      ))
    }
  </ul>

  <p class="course-list__empty" data-empty hidden={courses.length > 0}>
    {EMPTY_MESSAGES.all}
  </p>

  <p class="visually-hidden" role="status" data-status></p>
</div>

<style>
  .course-list {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-5);
    padding-left: max(var(--space-4), env(safe-area-inset-left));
    padding-right: max(var(--space-4), env(safe-area-inset-right));
  }

  [hidden] {
    display: none !important;
  }

  /* Filters: pills that stay in view while the list scrolls. */
  .course-list__filters {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-4) 0 var(--space-3);
    background: var(--color-background);
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: 0 var(--space-4);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-navy);
    font-weight: var(--font-weight-bold);
    cursor: pointer;
  }

  .filter__count {
    min-width: 1.5em;
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    font-size: var(--font-size-sm);
    text-align: center;
  }

  .filter[aria-pressed='true'] {
    border-color: var(--color-navy);
    background: var(--color-navy);
    color: var(--color-text-on-navy);
  }

  .filter[aria-pressed='true'] .filter__count {
    background: var(--color-mint);
    color: var(--color-navy);
  }

  /* Cards */
  .course-list__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .card__head {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .card__icon {
    flex-shrink: 0;
  }

  .card[data-played='true'] .card__icon--unplayed,
  .card[data-played='false'] .card__icon--played {
    display: none;
  }

  .card__name {
    font-size: var(--font-size-md);
    overflow-wrap: anywhere;
  }

  .card__location {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .card__chip {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--target-min);
    padding: 0 var(--space-2);
    border-radius: var(--radius-button);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    text-underline-offset: 3px;
  }

  .card__link-icon {
    flex-shrink: 0;
  }

  .card__played {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    margin-left: auto;
    padding: 0 var(--space-4) 0 var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    font-weight: var(--font-weight-bold);
    cursor: pointer;
  }

  .card__played input {
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--color-played);
    cursor: pointer;
  }

  /* Empty state */
  .course-list__empty {
    margin: var(--space-5) 0 0;
    padding: var(--space-5) var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    text-align: center;
    color: var(--color-text-muted);
  }

  /*
   * Short viewports (e.g. 400% zoom, landscape phones): the panel can be shorter than
   * the filters, so let them scroll away with the list (WCAG 1.4.10). Focused controls
   * then need no space kept clear above them. Kept last so it overrides the rules above.
   */
  @media (max-height: 32rem) {
    .course-list__filters {
      position: static;
    }

    .course-list__cards :is(a, input) {
      scroll-margin-top: 0;
    }
  }
</style>

<script>
  import { initCourseList } from './list';

  for (const root of document.querySelectorAll<HTMLElement>('[data-course-list]')) {
    initCourseList(root);
  }
</script>
