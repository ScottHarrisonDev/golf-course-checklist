---
/**
 * STUB (T02). T08 replaces the insides with the Leaflet map; T09 adds pins and the
 * detail card.
 *
 * Contract: fills the Map tab panel. Receives the courses as `courses`. Refresh the
 * map size when the panel dispatches `golf:tab-shown`.
 */
import { MAP_ARTWORK_URL } from '../../lib/map-config';
import type { Course } from '../../lib/types';

interface Props {
  courses: Course[];
}

const { courses } = Astro.props;
---

<div class="course-map">
  <h2 class="visually-hidden">Map</h2>
  <img src={MAP_ARTWORK_URL} alt="" class="course-map__artwork" />
  <p class="course-map__note">Map coming soon: {courses.length} courses to show.</p>
</div>

<style>
  .course-map {
    position: relative;
    height: 100%;
    background: var(--color-map-water);
  }

  .course-map__artwork {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .course-map__note {
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    margin: 0;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-float);
  }
</style>
